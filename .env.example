# GEMINI_API_KEY: API key for Gemini medical insights & verification engine
# Obtain your key at https://aistudio.google.com/ or Google Cloud Console
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server listening port (default: 3000)
PORT=3000

# APP_URL: Base URL of the deployment (e.g. http://localhost:3000 or your custom domain)
APP_URL="http://localhost:3000"
